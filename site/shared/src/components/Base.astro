---
// The html shell of every page: head (title, description, canonical, Open Graph, icons, preloaded fonts), the print
// definitions, skip link, header, main, footer. Nothing here loads from another origin or runs script; the optional
// review layer is a flag of the review build only and never part of the production output.
import "../styles/tokens.css";
import "../styles/layout.css";
import flex from "@fontsource-variable/roboto-flex/files/roboto-flex-latin-wght-normal.woff2?url";
import serif from "@fontsource-variable/noto-serif/files/noto-serif-latin-wght-normal.woff2?url";
import serifItalic from "@fontsource-variable/noto-serif/files/noto-serif-latin-wght-italic.woff2?url";
import Prints from "./Prints.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Link {
  label: string;
  href: string;
}
interface Props {
  title: string;
  description: string;
  path: string;
  siteUrl: string;
  pages: Link[];
  footPages: Link[];
  footAbout: Link[];
  legal: string;
  portal?: Link | null;
  source?: Link[];
  own?: string;
  current?: string;
  review?: boolean;
  // oblivios.dev: the name next to the logo, and no page-view counting (the spec counts views on oblivios.org only)
  tag?: string;
  analytics?: boolean;
}
const { title, description, path, siteUrl, pages, footPages, footAbout, legal, portal = null, source = [], own = "", current, review = false, tag, analytics: countViews = true } = Astro.props;
// Vercel Web Analytics (decision 261): one script from the site's own address, only in a build that Vercel makes
// (`VERCEL=1`), so a local build, the snapshot and the review build carry none. It sets no cookie.
const analytics = countViews && process.env.VERCEL === "1";
const canonical = siteUrl + (path === "/" ? "/" : path);
const image = siteUrl + "/social-preview.png";
const missing = path === "/404";
// A search result cuts a title at about 60 characters and a description at about 160: both are fitted here, once, at a
// word, so that no page depends on its author counting. A page of a list says which page it is, so that no two pages
// of the site share a description.
const fit = (s: string, max: number): string => {
  if (s.length <= max) return s;
  const cut = s.slice(0, max - 1);
  const atWord = cut.replace(/\s+\S*$/, ""); // a long unbreakable word (a path) would leave almost nothing: then cut inside it
  return (atWord.length >= max / 2 ? atWord : cut) + "…";
};
const shortTitle = fit(title.length <= 60 ? title : title.replace(/ \| [^|]+$/, ""), 60);
const pageNo = path.match(/^\/(?:decisions|boundaries|threat-model\/abuse-cases)\/(\d+)$/)?.[1];
const pageNote = pageNo ? ` Page ${pageNo}.` : "";
const desc = fit(description, 160 - pageNote.length) + pageNote;
// Structured data (schema.org JSON-LD): a data block, not script that runs, so the policy `default-src 'self'` holds.
// Every value is a fact the page or the footer already states: no rating, no licence, no app, no price.
const label = [...pages, ...footPages, ...footAbout].find((l) => l.href === path)?.label ?? title.split(":")[0];
const orgId = siteUrl + "/#org";
const siteId = siteUrl + "/#site";
const graph: Record<string, unknown>[] = [
  { "@type": "Organization", "@id": orgId, name: "ObliviOS", url: siteUrl + "/", logo: siteUrl + "/icon-512.png" },
  { "@type": "WebSite", "@id": siteId, url: siteUrl + "/", name: "ObliviOS", inLanguage: "en", publisher: { "@id": orgId } },
  { "@type": "WebPage", "@id": canonical + "#page", url: canonical, name: shortTitle, description: desc, inLanguage: "en", isPartOf: { "@id": siteId } },
];
if (path === "/") {
  graph.push({ "@type": "SoftwareSourceCode", "@id": siteUrl + "/#source", name: "ObliviOS", description: desc, codeRepository: source.map((s) => s.href), isBasedOn: { "@type": "CreativeWork", name: "GrapheneOS", url: "https://grapheneos.org" } });
} else {
  graph.push({ "@type": "BreadcrumbList", "@id": canonical + "#crumbs", itemListElement: [{ "@type": "ListItem", position: 1, name: "ObliviOS", item: siteUrl + "/" }, { "@type": "ListItem", position: 2, name: label, item: canonical }] });
}
const jsonld = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{shortTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f3eee6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181312" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ObliviOS" />
    <meta property="og:title" content={shortTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="The ObliviOS logo, a cloud with a server tower, printed in grey and brick red" />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content={missing ? "noindex" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    {!missing && <script type="application/ld+json" is:inline set:html={jsonld}></script>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={flex} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin />
    {review && <script src="/review.js" is:inline></script>}
    {analytics && <script defer src="/_vercel/insights/script.js" is:inline></script>}
    <slot name="head" />
  </head>
  <body>
    <slot name="defs"><Prints /></slot>
    <a class="skip" href="#main">Skip to the content</a>
    <Header pages={pages} current={current} portal={portal} tag={tag} />
    <main id="main"><slot /></main>
    <Footer pages={footPages} about={footAbout} source={source} own={own} legal={legal} />
  </body>
</html>
