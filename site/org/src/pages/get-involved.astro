---
import Page from "../layouts/Page.astro";
import PageHeader from "@oblivios/site-shared/components/PageHeader.astro";
import Print from "@oblivios/site-shared/components/Print.astro";
import { repos, sources } from "../lib/site.mjs";

const what = {
  "oblivios-docs": "The decisions, the threat model and the bill of materials. Start here.",
  "oblivios-manifest": "The pinned GrapheneOS and AOSP revisions that the patches apply to.",
  "oblivios-platform": "The patch packages: ObliviOS added to GrapheneOS source.",
  "oblivios-services": "The platform-independent logic and the native daemons.",
};
sources("get-involved", [
  "README.md of oblivios-docs (the four repositories and what each holds)",
  "CONTRIBUTING.md of oblivios-platform and oblivios-services (issues where the host enables them; no pull requests yet; a decision comes first)",
  "SECURITY.md (reply within 3 days)",
  "oblivios-docs is a snapshot made by a script (README.md of oblivios-docs)",
]);
---
<Page
  title="Get involved: ObliviOS"
  description="How to read the ObliviOS source, ask a question, report a problem or a claim that the records do not support. Pull requests are not accepted yet."
  path="/get-involved"
  current="/get-involved"
>
  <PageHeader crumb="Get involved" title="Get involved" lede="How to read the source, ask a question or tell me I am wrong, while ObliviOS is source only and I build it alone.">
    <Print id="br" label="A branch with three commits" />
  </PageHeader>
  <section class="band alt">
    <div class="c">
      <div class="prose">
        <h2>The four repositories</h2>
        <p>Everything is on GitHub, under one account. Read the records first: a change here starts with a decision, not with code.</p>
        <ul>
          {repos.map((r) => <li><a href={r.href}><code>{r.label}</code></a>. {what[r.label]}</li>)}
        </ul>
        <p>To check that they hold what this site says, follow <a href="/verify">Verify it</a>.</p>
      </div>
    </div>
  </section>
  <section class="band">
    <div class="c">
      <div class="prose">
        <h2>Ask, suggest, or tell me I am wrong</h2>
        <p>Issues can be opened on the repositories where GitHub allows them. I build ObliviOS alone, so I cannot promise how fast I answer. I ask for one thing above all: if a sentence on this site, in a README or in a record says more than the records support, tell me, and I will correct it or take it out.</p>
        <p>Pull requests are not accepted yet. <code>oblivios-docs</code> is a snapshot that a script makes from my private records, so a change to it is made at the source; open an issue instead.</p>
        <h2>Report a vulnerability</h2>
        <p>Do not open a public issue for a vulnerability. Follow the <a href="/security">security page</a>: an encrypted email, and a first reply from me within 3 days.</p>
        <h2>Not yet</h2>
        <p>There is no image to test, no update service, no forum and no mailing list. When ObliviOS offers more than source, this page says how to take part in it.</p>
      </div>
    </div>
  </section>
</Page>
