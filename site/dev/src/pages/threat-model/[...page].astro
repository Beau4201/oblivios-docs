---
import DocPage from "../../layouts/DocPage.astro";
import { security, partParams } from "../../lib/documents.mjs";

export function getStaticPaths() {
  return partParams(security[0]);
}
const entry = security[0];
const { part, pageNo } = Astro.props;
---
<DocPage
  entry={entry}
  part={part}
  pageNo={pageNo}
  crumbs={part.slug ? [{ label: "Home", href: "/" }, { label: entry.label, href: entry.href }, { label: part.label }] : [{ label: "Home", href: "/" }, { label: entry.label }]}
  current="/threat-model"
  print={entry.print}
  printLabel={entry.printLabel}
  lede={entry.lede}
  sub="security"
/>
