---
import Page from "../../layouts/Page.astro";
import Ph from "../../components/Ph.astro";
import AiCopy from "../../components/AiCopy.astro";
import Print from "@oblivios/site-shared/components/Print.astro";
import { guides, parseDoc } from "../../lib/documents.mjs";

const list = guides.map((g) => ({ ...g, title: parseDoc(g.file).title }));
---
<Page
  title="Guide | ObliviOS developer portal"
  description="Two guides for two readers: learn about ObliviOS, or build it for a Pixel 7a or a Pixel 10a and take it further."
  path="/guide"
  current="/guide"
>
  <Ph
    crumbs={[{ label: "Home", href: "/" }, { label: "Guide" }]}
    title="Guide"
    lede="Two guides for two readers: one to learn about ObliviOS, and one to build it and take it further."
    print="desk"
    printLabel="A writing desk"
  />
  <section class="band">
    <div class="c">
      <div class="plates two">
        {list.map((g) => (
          <a class="pl" href={g.href}>
            <Print id={g.plate} label={g.plateLabel} />
            <span class="kind">{g.kind}</span>
            <h3>{g.title}</h3>
            <p>{g.who}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="band alt">
    <div class="c">
      <div class="sh">
        <h2>Ask your own AI</h2>
        <p>If you would rather ask your own AI assistant than read the guides, give it this text. It reads the brief, which says where each fact lives and how to answer without inventing anything.</p>
      </div>
      <AiCopy />
    </div>
  </section>
</Page>
