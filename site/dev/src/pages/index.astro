---
import Page from "../layouts/Page.astro";
import Find from "../components/Find.astro";
import Print from "@oblivios/site-shared/components/Print.astro";
import { changelog, linked } from "../lib/changelog.mjs";
import { nav, repos } from "../lib/site.mjs";

// The plates follow the menu: the same groups in the same order, each with its pages, so a reader who has seen the header
// has seen the structure of the site. The groups, their lines and their pages are read from `nav`, never typed here.
const groups = nav.filter((n) => n.items);
const newest = changelog.slice(0, 3);
---
<Page
  title="ObliviOS developer portal: read the record"
  description="The decisions, the threat model, the engineering notes and the bill of materials of ObliviOS, read from the repository: every decision, every component, every advisory, and a search over all of it."
  path="/"
>
  <section class="hero">
    <div class="c">
      <div>
        <h1>Read the <em>record</em>.</h1>
        <p class="lede">Every decision ObliviOS has made, and the bill of materials of what it is built from, <b>read from the project's documents when the site is built</b>, so a page cannot drift from the record.</p>
        <form role="search" action="/search" method="get"><Find id="q-home" label="Search the record" placeholder="Search the record" /></form>
        <p class="hint">Try <a class="ulk" href="/search?q=ADR-208">ADR-208</a><a class="ulk" href="/search?q=compartments">Compartments</a><a class="ulk" href="/search?q=OFL-1.1">OFL-1.1</a></p>
      </div>
      <div class="plate">
        <Print id="desk" label="An open ledger with a lens over it" />
        <div class="stamp">Open record<small>Read from the documents at build</small></div>
      </div>
    </div>
  </section>

  <section class="band alt">
    <div class="c">
      <div class="lead">
        <div>
          <p class="big">This site writes nothing of its own. It reads the repository and shows what is there.</p>
          <p class="facts">The decision log, the threat model, the engineering notes and the bill of materials are read from <span class="m">docs/</span> and <span class="m">sbom/</span> when the site is built, and each decision, each document and each page of the bill of materials names the file it was read from. A new decision in the repository becomes a new page here, and nobody has to edit the site for it.</p>
        </div>
        <Print id="stack" label="A stack of sheets" />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="c">
      <div class="sh"><h2>Start where your question is</h2><p>Four places, in the order of the menu: learn it, see how it is built, read why it is so, look inside.</p></div>
      <div class="plates four">
        {groups.map((g) => (
          <article class="pl gp">
            <a class="pt" href={g.items[0].href} tabindex="-1" aria-hidden="true"><Print id={g.print} label={g.label} /></a>
            <h3><a href={g.items[0].href}><span class="ulk">{g.label}</span></a></h3>
            <p>{g.intro}</p>
            <ul>{g.items.map((p) => <li><a href={p.href}><span class="ulk">{p.label}</span></a></li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band alt">
    <div class="c">
      <div class="sh"><h2>What changed</h2><p>The latest publications of the snapshot, newest first.</p></div>
      <ol class="cl">
        {newest.map((e) => (
          <li id={e.id}>
            <time datetime={e.t} data-rel data-abs={e.stamp}>{e.stamp}</time>
            <p set:html={linked(e.text)} />
          </li>
        ))}
      </ol>
      <div class="btns after"><a class="btn" href="/changelog">Full changelog</a><a class="btn ghost" href="/decisions">All decisions</a></div>
    </div>
  </section>

  <section class="close">
    <div class="c">
      <div>
        <h2>All of it lives in four repositories.</h2>
        <p>The portal, the project site and the code are built from the same source, on the same account. Read it where it is written.</p>
      </div>
      <div class="btns">{repos.map((r) => <a class="btn ghost" href={r.href}>{r.label}</a>)}</div>
    </div>
  </section>
</Page>
