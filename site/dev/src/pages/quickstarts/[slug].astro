---
import DocPage from "../../layouts/DocPage.astro";
import { quickstarts } from "../../lib/documents.mjs";

export function getStaticPaths() {
  return quickstarts.map((q) => ({ params: { slug: q.slug }, props: { entry: q } }));
}
const { entry } = Astro.props;
---
<DocPage
  entry={entry}
  crumbs={[{ label: "Home", href: "/" }, { label: "Quickstarts", href: "/quickstarts" }, { label: entry.label }]}
  current="/quickstarts"
  print="term"
  printLabel="A terminal window"
/>
