---
import Page from "../layouts/Page.astro";
import Print from "@oblivios/site-shared/components/Print.astro";
---
<Page title="Page not found | ObliviOS developer portal" description="This address names no page of the ObliviOS developer portal." path="/404">
  <section class="band">
    <div class="c">
      <div class="nf">
        <Print id="ledger" label="An open ledger" />
        <h1>No page here.</h1>
        <p>The address names nothing in this record. Search for what you meant, or start from the decision log.</p>
        <div class="btns"><a class="btn" href="/search">Search</a><a class="btn ghost" href="/decisions">Decisions</a></div>
      </div>
    </div>
  </section>
</Page>
