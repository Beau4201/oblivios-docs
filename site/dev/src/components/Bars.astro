---
// A list of counts as bars. The bar is an svg with two rects, as on oblivios.org: the Content-Security-Policy allows no
// inline style, so no width is set in CSS.
import { esc } from "../lib/md.mjs";
import { fmt } from "../lib/records.mjs";

interface Props {
  rows: { label: string; value: number; sub?: string }[];
  total?: number;
}
const { rows, total } = Astro.props;
const top = total ?? Math.max(...rows.map((r) => r.value), 1);
const label = (s: string) => esc(s).replace(/\//g, "/<wbr>");
---
<ul class="sbars">
  {rows.map((r) => (
    <li class="sb">
      <span class="sn"><Fragment set:html={label(r.label)} />{r.sub && <small>{r.sub}</small>}</span>
      <svg class="sbt" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
        <rect class="trk" width="100" height="10" />
        <rect class="fl" width={Math.max(1.5, (100 * r.value) / top).toFixed(1)} height="10" />
      </svg>
      <b>{fmt(r.value)}</b>
    </li>
  ))}
</ul>
