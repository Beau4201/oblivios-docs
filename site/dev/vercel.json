{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "cd .. && npm ci --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/quickstarts", "destination": "/modules", "permanent": true },
    { "source": "/quickstarts.md", "destination": "/modules.md", "permanent": true },
    { "source": "/quickstarts/:slug", "destination": "/modules/:slug", "permanent": true },
    { "source": "/guide/review", "destination": "/guide/start", "permanent": true },
    { "source": "/guide/review.md", "destination": "/guide/start.md", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Link", "value": "</ai.md>; rel=\"describedby\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/search-index.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/feed/(.*)",
      "headers": [{ "key": "Content-Type", "value": "application/atom+xml; charset=utf-8" }]
    },
    {
      "source": "/security-contact.asc",
      "headers": [{ "key": "Content-Type", "value": "application/pgp-keys" }]
    }
  ]
}
